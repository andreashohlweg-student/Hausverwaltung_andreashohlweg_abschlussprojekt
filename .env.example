DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
NEON_BRANCH=production
NEON_AUTH_BASE_URL=https://AUTH_HOST/neondb/auth
NEON_AUTH_JWKS_URL=https://AUTH_HOST/neondb/auth/.well-known/jwks.json
NEON_AUTH_COOKIE_SECRET=GENERATE_A_RANDOM_SECRET_WITH_AT_LEAST_32_CHARACTERS
NEON_FUNCTION_HELLO_BASE_URL=https://FUNCTION_HOST/
FUNCTION_ORIGIN_SECRET=GENERATE_ANOTHER_RANDOM_SECRET
APP_URL=http://localhost:3000
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=admin@gmail.com
SMTP_PASS=
